<Window x:Class="Nighty.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:vm="clr-namespace:Nighty.ViewModels"
        xmlns:v="clr-namespace:Nighty.Views"
        xmlns:c="clr-namespace:Nighty.Controls"
        Title="Nighty" Icon="Assets/Nighty.ico" Width="1200" Height="800" MinWidth="940" MinHeight="620"
        Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource UiFont}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" Topmost="{Binding General.AlwaysOnTop}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CombatViewModel}"><v:CombatView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MsViewModel}"><v:MsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamingViewModel}"><v:GamingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsViewModel}"><v:ModsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExtrasViewModel}"><v:ExtrasView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MacrosViewModel}"><v:MacrosView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverlaysViewModel}"><v:OverlaysView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecordViewModel}"><v:RecordView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MusicViewModel}"><v:MusicView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditorViewModel}"><v:EditorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OwnerViewModel}"><v:OwnerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TestViewModel}"><v:TestView/></DataTemplate>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Top-bar pills: a rounded pill that glows when its page is the current one (Tag = is current) -->
        <Style x:Key="TopPill" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="999" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverLayerBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag">
                                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                                <Setter TargetName="Bd" Property="Background" Value="#2E7C5CFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#807C5CFF"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubPill" TargetType="Button" BasedOn="{StaticResource TopPill}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="13,6"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Frame">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- soft glow behind everything, top right -->
        <Border Grid.RowSpan="4" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.88,0" GradientOrigin="0.88,0" RadiusX="0.85" RadiusY="0.65">
                    <GradientStop Color="#2A5B3FD9" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- ===== Top bar: brand, pills, search, window buttons ===== -->
        <Grid Grid.Row="0" Margin="22,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,26,0">
                <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource PremiumBrush}">
                    <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/></Border.Effect>
                    <TextBlock Text="&#xE708;" Style="{StaticResource Icon}" Foreground="White" FontSize="14"/>
                </Border>
                <TextBlock Text="NIGHTY" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                <Border Background="{DynamicResource TileBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="9,1,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionBadge}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </StackPanel>

            <ItemsControl Grid.Column="1" ItemsSource="{Binding Groups}" VerticalAlignment="Center" AutomationProperties.Name="Navigation">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TopPill}" Content="{Binding Title}" Tag="{Binding IsSelected}" Margin="0,0,4,0"
                                Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Column="3" Width="240" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,8,58,8"
                         AutomationProperties.Name="Search" KeyDown="SearchBox_KeyDown" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="Search" Foreground="{DynamicResource MutedBrush}" FontSize="13.5" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding IsSearching, Converter={StaticResource BoolVisible}, ConverterParameter=!}"/>
                <Border Background="{DynamicResource Panel3Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="6,1"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False"
                        Visibility="{Binding IsSearching, Converter={StaticResource BoolVisible}, ConverterParameter=!}">
                    <TextBlock Text="Ctrl K" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                </Border>
                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                        Command="{Binding ClearSearchCommand}" AutomationProperties.Name="Clear search" BorderThickness="0" Background="Transparent"
                        WindowChrome.IsHitTestVisibleInChrome="True" Visibility="{Binding IsSearching, Converter={StaticResource BoolVisible}}"/>
                <Popup IsOpen="{Binding IsSearching, Mode=OneWay}" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" VerticalOffset="6">
                    <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="6" Width="300" MaxHeight="360">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Search results" SelectionChanged="SearchResults_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PageTitle}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No matches" Style="{StaticResource Muted}" Margin="12,6,0,6" Visibility="{Binding NoResults, Converter={StaticResource BoolVisible}}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="PinButton" Style="{StaticResource CaptionButton}" Content="&#xE718;" Click="Pin_Click" ToolTip="Keep Nighty on top" AutomationProperties.Name="Keep on top"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" AutomationProperties.Name="Minimize"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" AutomationProperties.Name="Maximize"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="Close"/>
            </StackPanel>
        </Grid>

        <!-- ===== Second row: the pages of the chosen heading ===== -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding SubItems}" Margin="22,0,22,6" AutomationProperties.Name="Pages"
                      Visibility="{Binding HasSubItems, Converter={StaticResource BoolVisible}}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource SubPill}" Content="{Binding Title}" Tag="{Binding IsCurrent}" Margin="0,0,4,0"
                            Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Content ===== -->
        <Grid Grid.Row="2">
            <Border Background="{DynamicResource ContentBackgroundBrush}" Opacity="0.55"/>
            <c:BackdropImage x:Name="Backdrop"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <c:PageHost Content="{Binding Current}" Margin="44,20,44,30" MaxWidth="1180" HorizontalAlignment="Stretch"/>
            </ScrollViewer>
        </Grid>

        <!-- ===== Status bar: Roblox, boost and clicker, always visible ===== -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="#40000000">
            <Grid Margin="22,0,12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <c:StatusDot Kind="{Binding RobloxKind}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RobloxText, StringFormat='Roblox {0}'}" Style="{StaticResource Muted}" Margin="8,0,26,0"/>
                    <c:StatusDot Kind="{Binding GameKind}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding GameText, StringFormat='FPS boost: {0}'}" Style="{StaticResource Muted}" Margin="8,0,26,0"/>
                    <c:StatusDot Kind="{Binding ClickerKind}" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="8,0,0,0"><Run Text="Clicker: "/><Run Text="{Binding StatusTitle, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding StatusDetail, Mode=OneWay}"/></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" Margin="0,0,10,0"/>
                    <Button Command="{Binding OpenGitHubCommand}" Style="{StaticResource GhostButton}" Padding="8,3" AutomationProperties.Name="Open GitHub" ToolTip="Open GitHub">
                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
