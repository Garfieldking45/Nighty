<Window x:Class="Nighty.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nighty.ViewModels"
        xmlns:v="clr-namespace:Nighty.Views"
        xmlns:c="clr-namespace:Nighty.Controls"
        Title="Nighty" Icon="Assets/Nighty.ico" Width="1200" Height="800" MinWidth="940" MinHeight="620"
        Background="{DynamicResource BgBrush}" FontFamily="{DynamicResource UiFont}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" Topmost="{Binding General.AlwaysOnTop}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CombatViewModel}"><v:CombatView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MsViewModel}"><v:MsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamingViewModel}"><v:GamingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UtilityViewModel}"><v:UtilityView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsViewModel}"><v:ModsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExtrasViewModel}"><v:ExtrasView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MacrosViewModel}"><v:MacrosView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverlaysViewModel}"><v:OverlaysView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecordViewModel}"><v:RecordView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MusicViewModel}"><v:MusicView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditorViewModel}"><v:EditorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OwnerViewModel}"><v:OwnerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TestViewModel}"><v:TestView/></DataTemplate>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Frame">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="262"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar: full height, brand on top ===== -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18,16,16">
                <!-- bottom block -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Command="{Binding OpenGitHubCommand}" Padding="14,11" Margin="0,0,0,10" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open GitHub">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Grid.Column="1" Text="GitHub" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>
                    </Button>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <c:StatusDot Kind="{Binding ClickerKind}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding StatusTitle}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Settings, pinned under a divider -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12" Visibility="{Binding IsSearching, Converter={StaticResource BoolVisible}, ConverterParameter=!}">
                    <Border Style="{StaticResource Divider}" Margin="6,0,6,8"/>
                    <ListBox ItemsSource="{Binding NavFoot}" SelectionChanged="Nav_SelectionChanged" SelectedItem="{Binding Selected, Mode=OneWay}" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Settings">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Width="28" FontSize="19">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Title}" Margin="14,0,0,0" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,16">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource PremiumBrush}">
                        <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/></Border.Effect>
                        <TextBlock Text="&#xE708;" Style="{StaticResource Icon}" Foreground="White" FontSize="20"/>
                    </Border>
                    <TextBlock Text="Nighty" FontSize="21" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource TileBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="9" Padding="7,2" Margin="10,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionBadge}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <!-- search with the Ctrl K hint -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="36,10,64,10"
                             AutomationProperties.Name="Search" KeyDown="SearchBox_KeyDown"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Search" Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolVisible}, ConverterParameter=!}"/>
                    <Border Background="{DynamicResource Panel3Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="7,2"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False"
                            Visibility="{Binding IsSearching, Converter={StaticResource BoolVisible}, ConverterParameter=!}">
                        <TextBlock Text="Ctrl K" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                            Command="{Binding ClearSearchCommand}" AutomationProperties.Name="Clear search" BorderThickness="0" Background="Transparent"
                            Visibility="{Binding IsSearching, Converter={StaticResource BoolVisible}}"/>
                </Grid>

                <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Search results"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolVisible}}" SelectionChanged="SearchResults_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PageTitle}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No matches" Style="{StaticResource Muted}" Margin="12,6,0,0"
                           Visibility="{Binding NoResults, Converter={StaticResource BoolVisible}}"/>

                <ListBox ItemsSource="{Binding NavMain}" SelectionChanged="Nav_SelectionChanged"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolVisible}, ConverterParameter=!}" SelectedItem="{Binding Selected, Mode=OneWay}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Width="28" FontSize="19">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Title}" Margin="14,0,0,0" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Border Background="{DynamicResource ContentBackgroundBrush}"/>
            <c:BackdropImage x:Name="Backdrop"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <c:PageHost Content="{Binding Current}" Margin="44,38,44,40" MaxWidth="1180" HorizontalAlignment="Stretch"/>
            </ScrollViewer>
            <!-- window buttons float over the page, top right -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="PinButton" Style="{StaticResource CaptionButton}" Content="&#xE718;" Click="Pin_Click" ToolTip="Keep Nighty on top" AutomationProperties.Name="Keep on top"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" AutomationProperties.Name="Minimize"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" AutomationProperties.Name="Maximize"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="Close"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
