<Window x:Class="Nighty.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nighty.ViewModels"
        xmlns:v="clr-namespace:Nighty.Views"
        xmlns:c="clr-namespace:Nighty.Controls"
        Title="Nighty" Icon="Assets/Nighty.ico" Width="1200" Height="800" MinWidth="940" MinHeight="620"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" Topmost="{Binding General.AlwaysOnTop}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CombatViewModel}"><v:CombatView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamingViewModel}"><v:GamingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UtilityViewModel}"><v:UtilityView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsViewModel}"><v:ModsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExtrasViewModel}"><v:ExtrasView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MacrosViewModel}"><v:MacrosView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverlaysViewModel}"><v:OverlaysView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,22,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource PremiumBrush}">
                        <TextBlock Text="&#xE708;" Style="{StaticResource Icon}" Foreground="White" FontSize="19"/>
                    </Border>
                    <TextBlock Text="Nighty" FontSize="21" FontWeight="SemiBold" Margin="13,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource TileBrush}" BorderBrush="#1F3A6B" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionBadge}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>

                <!-- bottom block -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Command="{Binding OpenGitHubCommand}" Padding="14,11" Margin="0,0,0,10" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open GitHub">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource TileBrush}">
                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="GitHub" FontSize="14" FontWeight="Medium" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </Button>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <c:StatusDot Kind="{Binding ClickerKind}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding StatusTitle}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" Margin="8,12,0,0"/>
                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,9,28,9"
                             AutomationProperties.Name="Search" KeyDown="SearchBox_KeyDown"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Search" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolVisible}, ConverterParameter=!}"/>
                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                            Command="{Binding ClearSearchCommand}" AutomationProperties.Name="Clear search" BorderThickness="0" Background="Transparent"
                            Visibility="{Binding IsSearching, Converter={StaticResource BoolVisible}}"/>
                </Grid>

                <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Search results"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolVisible}}" SelectionChanged="SearchResults_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PageTitle}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No matches" Style="{StaticResource Muted}" Margin="12,6,0,0"
                           Visibility="{Binding NoResults, Converter={StaticResource BoolVisible}}"/>

                <ListBox ItemsSource="{Binding Items}"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolVisible}, ConverterParameter=!}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Width="26" FontSize="18">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Title}" Margin="14,0,0,0" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Border Grid.Column="1" Background="{StaticResource ContentBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ContentControl Content="{Binding Current}" Margin="40,30,40,36" MaxWidth="1180" HorizontalAlignment="Stretch" IsTabStop="False"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
