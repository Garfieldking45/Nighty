<UserControl x:Class="Nighty.Controls.ValueStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource IconButton}" Content="&#xE738;" Click="OnDecrease" ToolTip="Decrease" AutomationProperties.Name="Decrease"/>
        <Slider Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                Minimum="{Binding Minimum, ElementName=Root}" Maximum="{Binding Maximum, ElementName=Root}"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
                TickFrequency="{Binding Step, ElementName=Root}" IsSnapToTickEnabled="True"
                SmallChange="{Binding Step, ElementName=Root}" LargeChange="{Binding Step, ElementName=Root}"/>
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE710;" Click="OnIncrease" ToolTip="Increase" AutomationProperties.Name="Increase"/>
        <Border Grid.Column="3" MinWidth="88" Height="30" Margin="10,0,0,0" CornerRadius="6" Background="{DynamicResource Panel2Brush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox x:Name="ValueBox" MinWidth="40" Padding="4,0" Background="Transparent" BorderThickness="0" FontWeight="SemiBold"
                         TextAlignment="Right" VerticalContentAlignment="Center" ToolTip="Type a value and press Enter"
                         GotKeyboardFocus="OnBoxFocus" LostKeyboardFocus="OnBoxLostFocus" PreviewKeyDown="OnBoxKeyDown"
                         AutomationProperties.Name="Value"/>
                <TextBlock x:Name="SuffixText" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
