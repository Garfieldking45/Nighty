<UserControl x:Class="Nighty.Views.CombatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nighty.Controls">
    <StackPanel>
        <c:PageHeading Title="Combat" Subtitle="Set up the clicker, then start it here or with your hotkey."/>

        <!-- ===== Hero: state, summary, live numbers, big start button ===== -->
        <Border Style="{StaticResource Card}" Padding="30,26">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14,7" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <c:StatusDot Kind="{Binding StateKind}"/>
                            <TextBlock Text="{Binding ChipText}" Margin="9,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding HeroTitle}" FontSize="28" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock Text="{Binding HeroSummary}" Style="{StaticResource Muted}" FontSize="15" Margin="0,4,0,0"/>
                    <UniformGrid Rows="1" Columns="6" Margin="0,26,0,0">
                        <StackPanel>
                            <TextBlock Text="TARGET" Style="{StaticResource Label}"/>
                            <TextBlock Margin="0,4,0,0"><Run Text="{Binding TargetValue, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/><Run Text=" CPS" FontSize="13" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="MEASURED" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding MeasuredValue}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="DUTY" Style="{StaticResource Label}"/>
                            <TextBlock Margin="0,4,0,0"><Run Text="{Binding DutyValue, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/><Run Text=" %" FontSize="13" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="BUTTON" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding ButtonValue}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="MODE" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding ModeValue}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="CLICKS" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding ClicksValue}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="30,12,0,0">
                    <Button Style="{StaticResource HeroButton}" Command="{Binding StartCommand}" AutomationProperties.Name="Start or stop clicking">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StartGlyph}" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource OnAccentBrush}"/>
                            <TextBlock Text="{Binding StartLabel}" Margin="12,0,0,0" Foreground="{StaticResource OnAccentBrush}" FontSize="17" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding StartHint}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left column ===== -->
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Icon="&#xE945;" Title="Click speed" Subtitle="Clicks per second">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="speedmode" Content="Exact"
                                                 IsChecked="{Binding Settings.UseRange, Converter={StaticResource Eq}, ConverterParameter=False}"/>
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="speedmode" Content="Range"
                                                 IsChecked="{Binding Settings.UseRange, Converter={StaticResource Eq}, ConverterParameter=True}"/>
                                </StackPanel>
                            </Border>
                        </c:CardHeader>
                        <StackPanel Visibility="{Binding Settings.UseRange, Converter={StaticResource Eq}, ConverterParameter=False}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource BigNumberBox}">
                                    <TextBlock VerticalAlignment="Center"><Run Text="{Binding CpsText, Mode=OneWay}" FontSize="40" FontWeight="SemiBold"/><Run Text=" CPS" FontSize="20" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                                </Border>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE738;" Width="52" Height="52" Margin="18,0,8,0" Command="{Binding CpsDown}" AutomationProperties.Name="Decrease CPS"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE710;" Width="52" Height="52" Command="{Binding CpsUp}" AutomationProperties.Name="Increase CPS"/>
                            </Grid>
                            <Slider Margin="0,22,0,0" Minimum="1" Maximum="50" Value="{Binding Settings.Cps, Mode=TwoWay}" TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="2"/>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="1" Style="{StaticResource Muted}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding PeriodText}" FontWeight="Medium" HorizontalAlignment="Center"/>
                                <TextBlock Text="50" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Settings.UseRange, Converter={StaticResource Eq}, ConverterParameter=True}">
                            <TextBlock Text="MINIMUM CPS" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <c:ValueStepper Value="{Binding Settings.MinCps, Mode=TwoWay}" Minimum="1" Maximum="50" Step="0.5" Decimals="1"/>
                            <TextBlock Text="MAXIMUM CPS" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                            <c:ValueStepper Value="{Binding Settings.MaxCps, Mode=TwoWay}" Minimum="1" Maximum="50" Step="0.5" Decimals="1"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="Each click picks a new random speed between the two values."/>
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" Margin="0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Calibrate" FontSize="13.5" FontWeight="Medium"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Tests how evenly this PC can deliver clicks (about 12 s, nothing is clicked) and sets the highest steady CPS."/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Calibrate" Command="{Binding Calibrate}" MinWidth="110"/>
                        </Grid>
                        <TextBlock Text="{Binding CalibrationMessage}" Style="{StaticResource Muted}" Margin="0,8,0,0" Foreground="{StaticResource SuccessBrush}"
                                   Visibility="{Binding CalibrationMessage, Converter={StaticResource NullVisible}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Icon="&#xE9D9;" Title="Click duty cycle" Subtitle="How long each click holds the button down"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource BigNumberBox}">
                                <TextBlock VerticalAlignment="Center"><Run Text="{Binding DutyText, Mode=OneWay}" FontSize="40" FontWeight="SemiBold"/><Run Text=" %" FontSize="20" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE738;" Width="52" Height="52" Margin="18,0,8,0" Command="{Binding DutyDown}" AutomationProperties.Name="Decrease duty cycle"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE710;" Width="52" Height="52" Command="{Binding DutyUp}" AutomationProperties.Name="Increase duty cycle"/>
                        </Grid>
                        <Slider Margin="0,22,0,0" Minimum="5" Maximum="95" Value="{Binding Settings.DutyCycle, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"/>
                        <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,16,0,0">
                            <c:DutyWaveform Height="104" DutyCycle="{Binding Settings.DutyCycle}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Icon="&#xE8B3;" Title="Clicks per hit" Subtitle="How many clicks are sent each time the clicker fires. Leave at 1 unless you need bursts."/>
                        <c:ValueStepper Value="{Binding ClicksPerHit, Mode=TwoWay}" Minimum="1" Maximum="5" Step="1"/>
                        <c:SettingRow Title="Randomize" Description="Varies the gap between hits (60-140% of the base) so the rhythm is never exactly even." Margin="0,14,0,0">
                            <CheckBox IsChecked="{Binding Settings.Jitter}"/>
                        </c:SettingRow>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Right column ===== -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Icon="&#xE962;" Title="Mouse button" Subtitle="Which button the clicker presses"/>
                        <UniformGrid Rows="1" Columns="3">
                            <RadioButton Style="{StaticResource OptionCard}" GroupName="btn" Margin="0,0,10,0" AutomationProperties.Name="Left button"
                                         IsChecked="{Binding Settings.Button, Converter={StaticResource Eq}, ConverterParameter=Left}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" FontSize="34" Margin="0,4,0,8"/>
                                    <TextBlock Text="Left" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Primary" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource OptionCard}" GroupName="btn" Margin="0,0,10,0" AutomationProperties.Name="Right button"
                                         IsChecked="{Binding Settings.Button, Converter={StaticResource Eq}, ConverterParameter=Right}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" FontSize="34" Margin="0,4,0,8"/>
                                    <TextBlock Text="Right" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Secondary" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource OptionCard}" GroupName="btn" AutomationProperties.Name="Middle button"
                                         IsChecked="{Binding Settings.Button, Converter={StaticResource Eq}, ConverterParameter=Middle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" FontSize="34" Margin="0,4,0,8"/>
                                    <TextBlock Text="Middle" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Wheel" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Icon="&#xE765;" Title="Activation" Subtitle="How your hotkey starts and stops clicking"/>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                            <UniformGrid Rows="1" Columns="2">
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="act" Content="Toggle" ToolTip="Press once to start, again to stop"
                                             IsChecked="{Binding Settings.Mode, Converter={StaticResource Eq}, ConverterParameter=Toggle}"/>
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="act" Content="Hold" ToolTip="Click only while the key is held"
                                             IsChecked="{Binding Settings.Mode, Converter={StaticResource Eq}, ConverterParameter=Hold}"/>
                            </UniformGrid>
                        </Border>
                        <c:SettingRow Title="Hotkey" Description="Click, then press a key or a mouse side button. Backspace clears it." Margin="0,16,0,6">
                            <c:HotkeyBox Vk="{Binding Settings.HotkeyVk, Mode=TwoWay}" Mods="{Binding Settings.HotkeyMods, Mode=TwoWay}"/>
                        </c:SettingRow>
                        <Border Style="{StaticResource Divider}"/>
                        <c:SettingRow Title="Hotkey enabled" Description="Turn off to keep the key free without forgetting it.">
                            <CheckBox IsChecked="{Binding Settings.Enabled}" AutomationProperties.Name="Enable clicker hotkey"/>
                        </c:SettingRow>
                        <Border Style="{StaticResource Divider}"/>
                        <c:SettingRow Title="Only while Roblox is focused" Description="Pauses clicking when another window is in front.">
                            <CheckBox IsChecked="{Binding Settings.OnlyWhenRobloxFocused}"/>
                        </c:SettingRow>
                        <c:InfoBanner Kind="Info" Text="{Binding HotkeyHint}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Icon="&#xE74E;" Title="Presets" Subtitle="Save this setup and load it any time"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Padding="12,10" AutomationProperties.Name="Preset name"/>
                            <Button Grid.Column="1" Content="Save" Command="{Binding SavePreset}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="20,10"/>
                        </Grid>
                        <TextBlock Text="{Binding PresetMessage}" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding PresetMessage, Converter={StaticResource NullVisible}}"/>
                        <TextBlock Text="No presets yet. Name the current setup and press Save." Style="{StaticResource Muted}" Margin="0,12,0,0"
                                   Visibility="{Binding Presets.Count, Converter={StaticResource Eq}, ConverterParameter=0}"/>
                        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Load" Padding="14,6" Margin="8,0,6,0"
                                                    Command="{Binding DataContext.LoadPreset, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete preset" AutomationProperties.Name="Delete preset"
                                                    Command="{Binding DataContext.DeletePreset, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
