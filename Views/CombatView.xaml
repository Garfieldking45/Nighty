<UserControl x:Class="Nighty.Views.CombatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nighty.Controls">
    <StackPanel>
        <c:PageHeading Title="Combat" Subtitle="Set up the clicker and your aim assist, then start it here or with your hotkey."/>
        <Border Style="{StaticResource TabBar}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TabButton}" Content="Clicker" GroupName="ctab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=0}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Aim assist" GroupName="ctab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=1}"/>
            </StackPanel>
        </Border>
        <StackPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=0}">

        <!-- ===== Hero: state, summary, live numbers, big start button ===== -->
        <Border Style="{StaticResource Card}" Padding="30,26">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14,7" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <c:StatusDot Kind="{Binding StateKind}"/>
                            <TextBlock Text="{Binding ChipText}" Margin="9,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding HeroTitle}" FontSize="28" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock Text="{Binding HeroSummary}" Style="{StaticResource Muted}" FontSize="15" Margin="0,4,0,0"/>
                    <UniformGrid Rows="1" Columns="6" Margin="0,26,0,0">
                        <StackPanel>
                            <TextBlock Text="TARGET" Style="{StaticResource Label}"/>
                            <TextBlock Margin="0,4,0,0"><Run Text="{Binding TargetValue, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/><Run Text=" CPS" FontSize="13" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="MEASURED" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding MeasuredValue}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="DUTY" Style="{StaticResource Label}"/>
                            <TextBlock Margin="0,4,0,0"><Run Text="{Binding DutyValue, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/><Run Text=" %" FontSize="13" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="BUTTON" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding ButtonValue}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="MODE" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding ModeValue}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="CLICKS" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding ClicksValue}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="30,12,0,0">
                    <Button Style="{StaticResource HeroButton}" Command="{Binding StartCommand}" AutomationProperties.Name="Start or stop clicking">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StartGlyph}" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource OnAccentBrush}"/>
                            <TextBlock Text="{Binding StartLabel}" Margin="12,0,0,0" Foreground="{DynamicResource OnAccentBrush}" FontSize="17" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding StartHint}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left column ===== -->
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Icon="&#xE945;" Title="Click speed" Subtitle="Clicks per second">
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="speedmode" Content="Exact"
                                                 IsChecked="{Binding Settings.UseRange, Converter={StaticResource Eq}, ConverterParameter=False}"/>
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="speedmode" Content="Range"
                                                 IsChecked="{Binding Settings.UseRange, Converter={StaticResource Eq}, ConverterParameter=True}"/>
                                </StackPanel>
                            </Border>
                        </c:CardHeader>
                        <StackPanel Visibility="{Binding Settings.UseRange, Converter={StaticResource Eq}, ConverterParameter=False}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource BigNumberBox}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <c:NumberEntry Value="{Binding Settings.Cps, Mode=TwoWay}" Minimum="1" Maximum="100" Decimals="1" MinWidth="96" FontSize="40" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" AutomationProperties.Name="Clicks per second"/>
                                        <TextBlock Text=" CPS" FontSize="20" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="2,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE738;" Width="52" Height="52" Margin="18,0,8,0" Command="{Binding CpsDown}" AutomationProperties.Name="Decrease CPS"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE710;" Width="52" Height="52" Command="{Binding CpsUp}" AutomationProperties.Name="Increase CPS"/>
                            </Grid>
                            <Slider Margin="0,22,0,0" Minimum="1" Maximum="100" Value="{Binding Settings.Cps, Mode=TwoWay}" TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="2"/>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="1" Style="{StaticResource Muted}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding PeriodText}" FontWeight="Medium" HorizontalAlignment="Center"/>
                                <TextBlock Text="100" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Settings.UseRange, Converter={StaticResource Eq}, ConverterParameter=True}">
                            <TextBlock Text="MINIMUM CPS" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <c:ValueStepper Value="{Binding Settings.MinCps, Mode=TwoWay}" Minimum="1" Maximum="100" Step="0.5" Decimals="1"/>
                            <TextBlock Text="MAXIMUM CPS" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                            <c:ValueStepper Value="{Binding Settings.MaxCps, Mode=TwoWay}" Minimum="1" Maximum="100" Step="0.5" Decimals="1"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="Each click picks a new random speed between the two values."/>
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" Margin="0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Calibrate" FontSize="13.5" FontWeight="Medium"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Tests this PC (about 15 s, nothing is clicked), aims for 34-35 CPS and picks the click duty cycle it releases most accurately."/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Calibrate" Command="{Binding Calibrate}" MinWidth="110"/>
                        </Grid>
                        <TextBlock Text="{Binding CalibrationMessage}" Style="{StaticResource Muted}" Margin="0,8,0,0" Foreground="{DynamicResource SuccessBrush}"
                                   Visibility="{Binding CalibrationMessage, Converter={StaticResource NullVisible}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Icon="&#xE9D9;" Title="Click duty cycle" Subtitle="How long each click holds the button down"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource BigNumberBox}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:NumberEntry Value="{Binding Settings.DutyCycle, Mode=TwoWay}" Minimum="5" Maximum="95" Decimals="0" MinWidth="60" FontSize="40" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" AutomationProperties.Name="Click duty cycle percent"/>
                                    <TextBlock Text=" %" FontSize="20" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="2,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE738;" Width="52" Height="52" Margin="18,0,8,0" Command="{Binding DutyDown}" AutomationProperties.Name="Decrease duty cycle"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE710;" Width="52" Height="52" Command="{Binding DutyUp}" AutomationProperties.Name="Increase duty cycle"/>
                        </Grid>
                        <Slider Margin="0,22,0,0" Minimum="5" Maximum="95" Value="{Binding Settings.DutyCycle, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"/>
                        <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,16,0,0">
                            <c:DutyWaveform Height="104" DutyCycle="{Binding Settings.DutyCycle}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SettingRow Title="Randomize" Description="Varies the gap between hits (60-140% of the base) so the rhythm is never exactly even.">
                            <CheckBox IsChecked="{Binding Settings.Jitter}"/>
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Icon="&#xE7C1;" Title="HitFix" Subtitle="Steadier, more consistent clicks"/>
                        <c:SettingRow Title="Enable HitFix" Description="While clicking, the clicker thread runs at time-critical priority, pinned to its own fast CPU core, without long garbage-collection pauses, and with an exact final wait before every click. Clicks land within a fraction of a millisecond, every time. It keeps one core busy while clicking, so leave it off on 2-core PCs.">
                            <CheckBox IsChecked="{Binding Settings.HitFix}" AutomationProperties.Name="Enable HitFix"/>
                        </c:SettingRow>
                        <c:InfoBanner Kind="Info" Text="{Binding EngineText}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Right column ===== -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Icon="&#xE962;" Title="Mouse button" Subtitle="Which button the clicker presses"/>
                        <UniformGrid Rows="1" Columns="3">
                            <RadioButton Style="{StaticResource OptionCard}" GroupName="btn" Margin="0,0,10,0" AutomationProperties.Name="Left button"
                                         IsChecked="{Binding Settings.Button, Converter={StaticResource Eq}, ConverterParameter=Left}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" FontSize="34" Margin="0,4,0,8"/>
                                    <TextBlock Text="Left" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Primary" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource OptionCard}" GroupName="btn" Margin="0,0,10,0" AutomationProperties.Name="Right button"
                                         IsChecked="{Binding Settings.Button, Converter={StaticResource Eq}, ConverterParameter=Right}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" FontSize="34" Margin="0,4,0,8"/>
                                    <TextBlock Text="Right" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Secondary" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource OptionCard}" GroupName="btn" AutomationProperties.Name="Middle button"
                                         IsChecked="{Binding Settings.Button, Converter={StaticResource Eq}, ConverterParameter=Middle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" FontSize="34" Margin="0,4,0,8"/>
                                    <TextBlock Text="Middle" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Wheel" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Icon="&#xE765;" Title="Activation" Subtitle="How your hotkey starts and stops clicking"/>
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                            <UniformGrid Rows="1" Columns="2">
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="act" Content="Toggle" ToolTip="Press once to start, again to stop"
                                             IsChecked="{Binding Settings.Mode, Converter={StaticResource Eq}, ConverterParameter=Toggle}"/>
                                <RadioButton Style="{StaticResource SegmentButton}" GroupName="act" Content="Hold" ToolTip="Click only while the key is held"
                                             IsChecked="{Binding Settings.Mode, Converter={StaticResource Eq}, ConverterParameter=Hold}"/>
                            </UniformGrid>
                        </Border>
                        <c:SettingRow Title="Hotkey" Description="Click, then press a key or a mouse side button. Backspace clears it." Margin="0,16,0,6">
                            <c:HotkeyBox Vk="{Binding Settings.HotkeyVk, Mode=TwoWay}" Mods="{Binding Settings.HotkeyMods, Mode=TwoWay}"/>
                        </c:SettingRow>
                        <Border Style="{StaticResource Divider}"/>
                        <c:SettingRow Title="Hotkey enabled" Description="Turn off to keep the key free without forgetting it.">
                            <CheckBox IsChecked="{Binding Settings.Enabled}" AutomationProperties.Name="Enable clicker hotkey"/>
                        </c:SettingRow>
                        <Border Style="{StaticResource Divider}"/>
                        <c:SettingRow Title="Only while Roblox is focused" Description="Pauses clicking when another window is in front.">
                            <CheckBox IsChecked="{Binding Settings.OnlyWhenRobloxFocused}"/>
                        </c:SettingRow>
                        <Border Style="{StaticResource Divider}"/>
                        <c:SettingRow Title="Stop in a screen corner" Description="Failsafe: throw the mouse into any corner of the desktop to stop clicking.">
                            <CheckBox IsChecked="{Binding Settings.StopInCorner}"/>
                        </c:SettingRow>
                        <c:InfoBanner Kind="Info" Text="{Binding HotkeyHint}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
        </StackPanel>

        <!-- ================= Aim assist (pointer) ================= -->
        <StackPanel Visibility="{Binding DataContext.Tab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Eq}, ConverterParameter=1}" DataContext="{Binding Tracking}">
            <c:InfoBanner Kind="Info" Text="Aim assist changes how the pointer moves while you aim: a slower pointer in slot 1 while clicking, pointer speed, acceleration and scroll speed. Your original Windows values are saved the first time you apply, and can be restored here."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SettingRow Title="Aim assist only in Roblox" Description="On: these values apply only while Roblox is in front, and Windows' own values come back as soon as you leave it.">
                        <CheckBox IsChecked="{Binding Settings.ApplyOnlyInRoblox}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}" Margin="0,18"/>
                    <c:SettingRow Title="Slow down in slot 1 while clicking" Description="While Roblox is in front, the Auto Clicker is clicking and hotbar slot 1 is selected (pick it with the 1 key), the pointer uses the slow speed below. In any other slot, or when you are not clicking, it stays at your normal Windows speed (the pointer speed below is not used while this is on).">
                        <CheckBox IsChecked="{Binding Settings.SlowInSlotOne}"/>
                    </c:SettingRow>
                    <TextBlock Text="{Binding LiveText}" Style="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="SLOW SPEED" Style="{StaticResource Label}" Margin="0,10,0,6"/>
                    <c:ValueStepper Value="{Binding SlowSpeed, Mode=TwoWay}" Minimum="1" Maximum="20" Step="1"/>
                    <Border Style="{StaticResource Divider}" Margin="0,18"/>
                    <c:CardHeader Icon="&#xE945;" Title="Pointer speed" Subtitle="Windows pointer speed, 1–20 (10 is the Windows default)."/>
                    <c:ValueStepper Value="{Binding Speed, Mode=TwoWay}" Minimum="1" Maximum="20" Step="1"/>
                    <Border Style="{StaticResource Divider}" Margin="0,18"/>
                    <c:SettingRow Title="Enhance pointer precision" Description="Mouse acceleration. Turn off for 1:1 movement that matches your hand speed.">
                        <CheckBox IsChecked="{Binding Settings.EnhancePointerPrecision}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}" Margin="0,18"/>
                    <c:CardHeader Icon="&#xE945;" Title="Scroll speed" Subtitle="Lines per wheel notch (0 leaves your Windows setting alone)."/>
                    <c:ValueStepper Value="{Binding ScrollLines, Mode=TwoWay}" Minimum="0" Maximum="100" Step="1"/>
                    <Border Style="{StaticResource Divider}" Margin="0,18"/>
                    <c:CardHeader Icon="&#xE945;" Title="Double-click speed" Subtitle="How quickly two clicks must follow to count as a double click, in ms (0 leaves Windows alone)."/>
                    <c:ValueStepper Value="{Binding DoubleClickMs, Mode=TwoWay}" Minimum="0" Maximum="900" Step="50"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="PRESETS" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Slow (6)" Command="{Binding PresetCommand}" CommandParameter="6"/>
                        <Button Content="Windows default (10)" Command="{Binding PresetCommand}" CommandParameter="10" Margin="8,0,0,0"/>
                        <Button Content="Fast (14)" Command="{Binding PresetCommand}" CommandParameter="14" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Apply" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" MinWidth="96"/>
                        <Button Content="Restore original" Command="{Binding RestoreCommand}" Margin="10,0,0,0"/>
                        <Button Content="Load current values" Command="{Binding LoadCurrentCommand}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,12,0,0" Foreground="{Binding Kind, Converter={StaticResource StatusBrush}}"
                               Visibility="{Binding Message, Converter={StaticResource NullVisible}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE946;" Title="Sensitivity calculator" Subtitle="Compare setups: eDPI is your mouse DPI times your in-game sensitivity."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MOUSE DPI" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <c:ValueStepper Value="{Binding Dpi, Mode=TwoWay}" Minimum="100" Maximum="32000" Step="100"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="IN-GAME SENSITIVITY" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <c:ValueStepper Value="{Binding Sensitivity, Mode=TwoWay}" Minimum="0.01" Maximum="100" Step="0.05" Decimals="2"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding CalcText}" Margin="0,14,0,0" FontWeight="Medium" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE962;" Title="Mouse test pad" Subtitle="Check how the pointer follows your mouse, and your polling rate"/>
                    <c:MouseTestPad x:Name="Pad" MouseDpi="{Binding Dpi}"/>
                    <TextBlock Text="{Binding MultiplierText, ElementName=Pad}" FontWeight="Medium" Margin="2,12,0,0"/>
                    <TextBlock Text="{Binding AccelText, ElementName=Pad}" Style="{StaticResource Muted}" Margin="2,4,0,0"/>
                    <TextBlock Text="{Binding DpiText, ElementName=Pad}" Style="{StaticResource Muted}" Margin="2,4,0,0"/>
                    <TextBlock Text="{Binding PollingText, ElementName=Pad}" Style="{StaticResource Muted}" Margin="2,4,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="2,10,0,0" Text="Games with raw input (most shooters) ignore Windows pointer settings and read the mouse directly. For custom acceleration curves you need a separate driver like Raw Accel."/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE946;" Title="Current Windows state" Subtitle="{Binding CurrentText}"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </StackPanel>
</UserControl>
