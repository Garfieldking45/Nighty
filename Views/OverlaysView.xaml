<UserControl x:Class="Nighty.Views.OverlaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nighty.Controls">
    <StackPanel>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <c:PageHeading Title="Overlays" Subtitle="On-screen readouts that stay on top of your game and never intercept clicks." Margin="0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ Add crosshair" Command="{Binding AddCrosshairCommand}"/>
                <Button Content="+ Add key overlay" Command="{Binding AddKeyCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Visibility="{Binding FpsNeedsSetup, Converter={StaticResource BoolVisible}}">
            <c:InfoBanner Kind="Warning" Margin="0,0,0,8"
                          Text="The FPS overlay reads real frame events from Windows, which is only allowed for administrators and members of “Performance Log Users”. Turning it on runs a one-time setup automatically (one admin prompt); sign out and back in afterwards. You can also run it again here, or restart as administrator."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Content="Run one-time setup again" Command="{Binding SetupFpsCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Restart as administrator" Command="{Binding RelaunchAdminCommand}" Margin="10,0,0,0"/>
                <TextBlock Text="{Binding SetupMessage}" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <c:CardHeader Icon="&#xE946;" Title="Preview and position" Subtitle="Drag the tiles on the miniature screen, or use the exact position controls on each card below."/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Reset positions" Command="{Binding ResetPositionsCommand}" VerticalAlignment="Top"/>
                </Grid>
                <c:OverlayPreview Items="{Binding Items}" MaxWidth="560" HorizontalAlignment="Left" Width="560"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                           Text="Overlays show over windowed and borderless-fullscreen games. Exclusive fullscreen can hide them."/>
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentHoverBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
<TextBlock Text="{Binding Blurb}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE74D;" Margin="0,0,12,0" ToolTip="Remove this key overlay" AutomationProperties.Name="Remove overlay"
                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolVisible}}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                <CheckBox Grid.Column="3" IsChecked="{Binding Enabled}" AutomationProperties.Name="{Binding Title}"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="HORIZONTAL POSITION" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <c:ValueStepper Value="{Binding X, Mode=TwoWay}" Minimum="0" Maximum="100" Step="1" Decimals="1" Suffix="%"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="VERTICAL POSITION" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <c:ValueStepper Value="{Binding Y, Mode=TwoWay}" Minimum="0" Maximum="100" Step="1" Decimals="1" Suffix="%"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                    <TextBlock Text="SIZE" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <c:ValueStepper Value="{Binding Scale, Mode=TwoWay}" Minimum="0.5" Maximum="2.5" Step="0.05" Decimals="2" Suffix="×"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                    <TextBlock Text="OPACITY" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                    <c:ValueStepper Value="{Binding Opacity, Mode=TwoWay}" Minimum="0.2" Maximum="1" Step="0.05" Decimals="2"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Visibility="{Binding Kind, Converter={StaticResource Eq}, ConverterParameter=Crosshair}">
                                <Border Style="{StaticResource Divider}" Margin="0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="STYLE" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding DataContext.CrosshairStyles, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Style}" AutomationProperties.Name="Crosshair style"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="COLOUR" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding DataContext.CrosshairColors, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Hex" SelectedValue="{Binding Color}" AutomationProperties.Name="Crosshair colour"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                        <TextBlock Text="ARM LENGTH" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <c:ValueStepper Value="{Binding ArmLength, Mode=TwoWay}" Minimum="1" Maximum="80" Step="1" Suffix=" px"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                        <TextBlock Text="THICKNESS" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <c:ValueStepper Value="{Binding Thickness, Mode=TwoWay}" Minimum="1" Maximum="10" Step="1" Suffix=" px"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                        <TextBlock Text="CENTRE GAP" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                        <c:ValueStepper Value="{Binding Gap, Mode=TwoWay}" Minimum="0" Maximum="60" Step="1" Suffix=" px"/>
                                    </StackPanel>
                                    <c:SettingRow Grid.Row="2" Grid.Column="2" Margin="0,14,0,0" Title="Dark outline" Description="Keeps it visible on bright backgrounds.">
                                        <CheckBox IsChecked="{Binding Outline}"/>
                                    </c:SettingRow>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <c:CardHeader Icon="&#xE7F4;" Title="Share overlays" Subtitle="A .nightyoverlay file holds only overlay positions and styles: no settings, keys or anything else from your PC. Loading one replaces your overlays, and Undo brings yours back."/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save overlays" Command="{Binding SaveLayoutCommand}"/>
                    <Button Content="Load overlays" Command="{Binding LoadLayoutCommand}" Margin="8,0,0,0"/>
                    <Button Content="Undo last load" Command="{Binding UndoLoadCommand}" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding ShareMessage}" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <c:SettingRow Title="Ping host" Description="The Ping overlay measures round-trip time (ICMP) to this host. Some hosts block ping.">
                <TextBox Text="{Binding Settings.PingHost, UpdateSourceTrigger=LostFocus}" Width="190" AutomationProperties.Name="Ping host"/>
            </c:SettingRow>
        </Border>
    </StackPanel>
</UserControl>
