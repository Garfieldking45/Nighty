<UserControl x:Class="Nighty.Views.GamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nighty.Controls">
    <UserControl.Resources>
        <Style x:Key="PowerButton" TargetType="Button">
            <Setter Property="Width" Value="148"/>
            <Setter Property="Height" Value="148"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Margin="-8" Fill="{DynamicResource AccentSoftBrush}" x:Name="Glow" Opacity="0"/>
                            <Ellipse x:Name="Ring" Fill="{DynamicResource Panel2Brush}" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="3"/>
                            <TextBlock x:Name="Glyph" Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="52" Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource OptionActiveBrush}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentHoverBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentHoverBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MeterBar" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="6"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,0,0,18">
            <c:PageHeading Title="Gaming" Subtitle="Free up system resources while you play, and clean out junk files safely." Margin="0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <RadioButton Style="{StaticResource TabButton}" Content="Game Mode" GroupName="gtab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=0}"/>
            <RadioButton Style="{StaticResource TabButton}" Content="Cleaner" GroupName="gtab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=1}"/>
            <RadioButton Style="{StaticResource TabButton}" Content="Tweaks" GroupName="gtab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=2}"/>
        </StackPanel>

        <!-- ================= Game Mode ================= -->
        <Grid Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=0}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Button Style="{StaticResource PowerButton}" Command="{Binding PowerCommand}" HorizontalAlignment="Center" Margin="0,10,0,18"
                                AutomationProperties.Name="Game Mode power"/>
                        <TextBlock Text="{Binding PowerLabel}" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PowerHint}" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,5,0,8"/>
                        <TextBlock Text="{Binding GameStatus}" Style="{StaticResource Muted}" Foreground="{DynamicResource SuccessBrush}" TextAlignment="Center" Margin="0,2,0,4"
                                   Visibility="{Binding GameStatus, Converter={StaticResource NullVisible}}"/>
                        <c:SettingRow Title="Turn on automatically" Description="Enables Game Mode when Roblox starts and restores your settings when it closes.">
                            <CheckBox IsChecked="{Binding Game.AutoGameMode}"/>
                        </c:SettingRow>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Icon="&#xE9D9;" Title="System usage" Margin="0,0,0,12"/>
                        <Grid>
                            <TextBlock Text="CPU" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding CpuText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding Cpu, Mode=OneWay}" Margin="0,6,0,14"/>
                        <Grid>
                            <TextBlock Text="Memory" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding RamText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding Ram, Mode=OneWay}" Margin="0,6,0,14"/>
                        <TextBlock Text="{Binding RobloxText}" Style="{StaticResource Muted}"/>
                        <Border Style="{StaticResource Divider}" Margin="0,14"/>
                        <UniformGrid Columns="2">
                            <StackPanel><TextBlock Text="APPS SLOWED DOWN" Style="{StaticResource Label}"/><TextBlock Text="{Binding AppsSlowedText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel><TextBlock Text="MEMORY FREED" Style="{StaticResource Label}"/><TextBlock Text="{Binding MemoryFreedText}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <c:InfoBanner Kind="Info" Text="Game Mode only changes the options you enable below. Everything it changes is remembered and put back when you turn it off or close Nighty."/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:CardHeader Icon="&#xE7E8;" Title="Optimizations" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border Style="{StaticResource Divider}" Margin="0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13.5"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource NullVisible}}">
                                                    <c:StatusDot Kind="{Binding Kind}"/>
                                                    <TextBlock Text="{Binding Status}" Margin="8,0,0,0" FontSize="12" Foreground="{Binding Kind, Converter={StaticResource StatusBrush}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.Name="{Binding Title}"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ================= Cleaner ================= -->
        <StackPanel Visibility="{Binding DataContext.Tab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Eq}, ConverterParameter=1}" DataContext="{Binding Cleaner}">
            <c:InfoBanner Kind="Info" Text="The Cleaner only looks in the fixed locations listed below. Scan first to preview every file, then clean. Files that are in use are skipped, and nothing outside these locations is touched."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE74D;" Title="What to clean" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource Divider}" Margin="0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Category.Name}" FontWeight="Medium" FontSize="13.5"/>
                                            <TextBlock Text="{Binding Category.Description}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                            <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource WarningBrush}" Margin="0,3,0,0"
                                                       Text="Needs administrator rights — without them most files will be skipped."
                                                       Visibility="{Binding AdminWarning, Converter={StaticResource BoolVisible}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,18,0" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="110">
                                            <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Right" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding Selected}" AutomationProperties.Name="{Binding Category.Name}"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Scan" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" MinWidth="96"/>
                            <Button Content="Clean selected" Command="{Binding CleanCommand}" Margin="10,0,0,0"/>
                            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisible}}"/>
                    <c:InfoBanner Kind="{Binding StatusKind}" Text="{Binding Status}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasScan, Converter={StaticResource BoolVisible}}">
                <StackPanel>
                    <TextBlock Text="Preview — largest files first (up to 300 shown)" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource Panel2Brush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <ListBox ItemsSource="{Binding Preview}" MaxHeight="280" Background="Transparent" BorderThickness="0" Padding="6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,2"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= Tweaks ================= -->
        <StackPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=2}">
            <c:InfoBanner Kind="Info" Text="These tweaks change Windows settings for your account only (no administrator rights needed). Each one remembers your exact original value and can be switched off at any time. They stay on until you turn them off, even after closing Nighty."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <c:CardHeader Icon="&#xE713;" Title="PC tweaks" Subtitle="Small changes that free up GPU, CPU and focus for your game."/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Turn all off" Command="{Binding RestoreTweaksCommand}" VerticalAlignment="Top"/>
                    </Grid>
                    <TextBlock Text="{Binding TweaksMessage}" Style="{StaticResource Muted}" Foreground="{DynamicResource SuccessBrush}" Margin="0,10,0,0"
                               Visibility="{Binding TweaksMessage, Converter={StaticResource NullVisible}}"/>
                    <ItemsControl ItemsSource="{Binding TweakOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource Divider}" Margin="0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13.5"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource NullVisible}}">
                                                <c:StatusDot Kind="{Binding Kind}"/>
                                                <TextBlock Text="{Binding Status}" Margin="8,0,0,0" FontSize="12" Foreground="{Binding Kind, Converter={StaticResource StatusBrush}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.Name="{Binding Title}"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
