<UserControl x:Class="Nighty.Views.UtilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nighty.Controls">
    <StackPanel>
        <StackPanel Margin="0,0,0,18">
            <c:PageHeading Title="Utility" Subtitle="Display, input, and network helpers. Every change is saved first so it can be undone." Margin="0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <RadioButton Style="{StaticResource TabButton}" Content="Brightness" GroupName="utab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=0}"/>
            <RadioButton Style="{StaticResource TabButton}" Content="Movement Helper" GroupName="utab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=1}"/>
            <RadioButton Style="{StaticResource TabButton}" Content="Tracking Helper" GroupName="utab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=2}"/>
            <RadioButton Style="{StaticResource TabButton}" Content="Best DNS" GroupName="utab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=3}"/>
            <RadioButton Style="{StaticResource TabButton}" Content="QoS Policy" GroupName="utab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=4}"/>
        </StackPanel>

        <!-- ================= Brightness ================= -->
        <StackPanel Visibility="{Binding DataContext.Tab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Eq}, ConverterParameter=0}" DataContext="{Binding Brightness}">
            <c:InfoBanner Kind="Info" Text="Brightness uses only supported controls: Windows' built-in panel interface for laptops and DDC/CI for external monitors. Displays that don't expose either are listed as unsupported."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Display" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" Text="{Binding Selected.Method}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Rescan displays" Command="{Binding RefreshCommand}"/>
                    </Grid>
                    <ComboBox ItemsSource="{Binding Displays}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" Margin="0,14,0,0"
                              Visibility="{Binding NoDisplays, Converter={StaticResource BoolVisible}, ConverterParameter=!}" AutomationProperties.Name="Display"/>
                    <TextBlock Text="Looking for displays…" Style="{StaticResource Muted}" Margin="0,14,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisible}}"/>
                    <c:InfoBanner Kind="Warning" Margin="0,14,0,0" Text="No display with software brightness control was found. Desktop monitors often need DDC/CI enabled in their on-screen menu."
                                  Visibility="{Binding NoDisplays, Converter={StaticResource BoolVisible}}"/>
                    <c:InfoBanner Kind="Warning" Margin="0,14,0,0" Text="{Binding UnsupportedReason}" Visibility="{Binding UnsupportedReason, Converter={StaticResource NullVisible}}"/>

                    <StackPanel Visibility="{Binding IsSupported, Converter={StaticResource BoolVisible}}" Margin="0,18,0,0">
                        <TextBlock Text="BRIGHTNESS" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <c:ValueStepper Value="{Binding Value, Mode=TwoWay}" Minimum="{Binding Min}" Maximum="{Binding Max}" Step="1" Suffix="%"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Restore original" Command="{Binding RestoreCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,12,0,0" Foreground="{Binding Kind, Converter={StaticResource StatusBrush}}"
                               Visibility="{Binding Message, Converter={StaticResource NullVisible}}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Visibility="{Binding DataContext.Tab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Eq}, ConverterParameter=0}" DataContext="{Binding Brightness}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE706;" Title="Software boost" Subtitle="Make your screen brighter or darker. Over 100% lights up dark areas.">
                        <Button Content="Reset" Command="{Binding SoftResetCommand}"/>
                    </c:CardHeader>
                    <c:ValueStepper Value="{Binding SoftLevel, Mode=TwoWay}" Minimum="40" Maximum="150" Step="5" Suffix="%"/>
                    <TextBlock Text="{Binding SoftLabel}" FontWeight="Medium" Margin="0,12,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="The boost brightens dark and mid tones on your main display. It goes back to normal when you press Reset or close Nighty."/>
                    <TextBlock Text="{Binding SoftMessage}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding SoftMessage, Converter={StaticResource NullVisible}}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= Movement helper ================= -->
        <StackPanel Visibility="{Binding DataContext.Tab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Eq}, ConverterParameter=1}" DataContext="{Binding Movement}">
            <Border Style="{StaticResource Card}">
                <StackPanel DataContext="{Binding Socd}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="&#xE7C9;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" FontSize="15"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <c:CardHeader Icon="&#xE765;" Title="Movement Helper" Subtitle="What happens when you hold left and right (or forward and back) together"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}" Margin="0,14"/>
                    <c:SettingRow Title="Turn on" Description="Only one direction counts at a time, so you never stand still by accident.">
                        <CheckBox IsChecked="{Binding Enabled}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Mode" Description="{Binding Mode, Converter={StaticResource SocdDesc}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource TabButton}" Content="Last input" GroupName="socd" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=LastInput}"/>
                            <RadioButton Style="{StaticResource TabButton}" Content="Neutral" GroupName="socd" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Neutral}"/>
                            <RadioButton Style="{StaticResource TabButton}" Content="First input" GroupName="socd" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=FirstInput}"/>
                        </StackPanel>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Left and right" Description="Your strafe keys.">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Chip}" Padding="14,6"><TextBlock Text="A" FontWeight="SemiBold"/></Border>
                            <TextBlock Text="&#xE7C9;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="10,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Chip}" Padding="14,6"><TextBlock Text="D" FontWeight="SemiBold"/></Border>
                            <CheckBox IsChecked="{Binding LeftRight}" Margin="18,0,0,0"/>
                        </StackPanel>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Forward and back" Description="Your walk keys.">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Chip}" Padding="14,6"><TextBlock Text="W" FontWeight="SemiBold"/></Border>
                            <TextBlock Text="&#xE7C9;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="10,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Chip}" Padding="14,6"><TextBlock Text="S" FontWeight="SemiBold"/></Border>
                            <CheckBox IsChecked="{Binding ForwardBack}" Margin="18,0,0,0"/>
                        </StackPanel>
                    </c:SettingRow>
                    <c:InfoBanner Kind="Warning" Margin="0,14,0,0" Text="If a game runs as administrator, run Nighty as administrator too. Some games don't allow this kind of tool, so check the rules before using it online."/>
                </StackPanel>
            </Border>
            <c:InfoBanner Kind="Info" Text="Stops Windows accessibility pop-ups (for example 5× Shift for Sticky Keys) from interrupting WASD movement, and can speed up key repeat. Changes apply immediately; “Restore original” puts back your exact previous values."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SettingRow Title="Disable Sticky Keys shortcut" Description="Pressing Shift five times will no longer open the Sticky Keys prompt.">
                        <CheckBox IsChecked="{Binding Settings.DisableStickyKeysShortcut}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Disable Filter Keys shortcut" Description="Holding Right Shift for eight seconds will no longer enable Filter Keys.">
                        <CheckBox IsChecked="{Binding Settings.DisableFilterKeysShortcut}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Disable Toggle Keys shortcut" Description="Holding Num Lock for five seconds will no longer trigger Toggle Keys.">
                        <CheckBox IsChecked="{Binding Settings.DisableToggleKeysShortcut}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Fast key repeat" Description="Shortest repeat delay and fastest repeat rate for held keys.">
                        <CheckBox IsChecked="{Binding Settings.FastKeyRepeat}"/>
                    </c:SettingRow>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE946;" Title="Current Windows state" Subtitle="{Binding CurrentText}"/>
                    <Button Content="Restore original" Command="{Binding RestoreCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,12,0,0" Foreground="{Binding Kind, Converter={StaticResource StatusBrush}}"
                               Visibility="{Binding Message, Converter={StaticResource NullVisible}}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= Tracking helper ================= -->
        <StackPanel Visibility="{Binding DataContext.Tab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Eq}, ConverterParameter=2}" DataContext="{Binding Tracking}">
            <c:InfoBanner Kind="Info" Text="Sets Windows' pointer speed and “Enhance pointer precision” (mouse acceleration). Your original values are saved the first time you apply, and can be restored here."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SettingRow Title="Tracking Helper (Roblox only)" Description="On: these values apply only while Roblox is in front, and Windows' own values come back as soon as you leave it.">
                        <CheckBox IsChecked="{Binding Settings.ApplyOnlyInRoblox}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}" Margin="0,14,0,18"/>
                    <c:SettingRow Title="Slow down in slot 1" Description="While hotbar slot 1 is selected (pick it with the 1 key) the pointer uses the slow speed below. In every other slot, or after scrolling the hotbar, it uses the other-slots speed. Roblox only.">
                        <CheckBox IsChecked="{Binding Settings.SlowInSlotOne}"/>
                    </c:SettingRow>
                    <TextBlock Text="SLOW SPEED" Style="{StaticResource Label}" Margin="0,10,0,6"/>
                    <c:ValueStepper Value="{Binding SlowSpeed, Mode=TwoWay}" Minimum="1" Maximum="20" Step="1"/>
                    <TextBlock Text="SPEED IN OTHER SLOTS" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                    <c:ValueStepper Value="{Binding OtherSlotSpeed, Mode=TwoWay}" Minimum="1" Maximum="20" Step="1"/>
                    <TextBlock Text="10 is the Windows default. This replaces the pointer speed above while slot 1 slowdown is on and Roblox is in front." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    <Border Style="{StaticResource Divider}" Margin="0,18"/>
                    <c:CardHeader Icon="&#xE945;" Title="Pointer speed" Subtitle="Windows pointer speed, 1–20 (10 is the Windows default)."/>
                    <c:ValueStepper Value="{Binding Speed, Mode=TwoWay}" Minimum="1" Maximum="20" Step="1"/>
                    <Border Style="{StaticResource Divider}" Margin="0,18"/>
                    <c:SettingRow Title="Enhance pointer precision" Description="Mouse acceleration. Turn off for 1:1 movement that matches your hand speed.">
                        <CheckBox IsChecked="{Binding Settings.EnhancePointerPrecision}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}" Margin="0,18"/>
                    <c:CardHeader Icon="&#xE945;" Title="Scroll speed" Subtitle="Lines per wheel notch (0 leaves your Windows setting alone)."/>
                    <c:ValueStepper Value="{Binding ScrollLines, Mode=TwoWay}" Minimum="0" Maximum="100" Step="1"/>
                    <Border Style="{StaticResource Divider}" Margin="0,18"/>
                    <c:CardHeader Icon="&#xE945;" Title="Double-click speed" Subtitle="How quickly two clicks must follow to count as a double click, in ms (0 leaves Windows alone)."/>
                    <c:ValueStepper Value="{Binding DoubleClickMs, Mode=TwoWay}" Minimum="0" Maximum="900" Step="50"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="PRESETS" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Slow (6)" Command="{Binding PresetCommand}" CommandParameter="6"/>
                        <Button Content="Windows default (10)" Command="{Binding PresetCommand}" CommandParameter="10" Margin="8,0,0,0"/>
                        <Button Content="Fast (14)" Command="{Binding PresetCommand}" CommandParameter="14" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Apply" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" MinWidth="96"/>
                        <Button Content="Restore original" Command="{Binding RestoreCommand}" Margin="10,0,0,0"/>
                        <Button Content="Load current values" Command="{Binding LoadCurrentCommand}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,12,0,0" Foreground="{Binding Kind, Converter={StaticResource StatusBrush}}"
                               Visibility="{Binding Message, Converter={StaticResource NullVisible}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE946;" Title="Sensitivity calculator" Subtitle="Compare setups: eDPI is your mouse DPI times your in-game sensitivity."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MOUSE DPI" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <c:ValueStepper Value="{Binding Dpi, Mode=TwoWay}" Minimum="100" Maximum="32000" Step="100"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="IN-GAME SENSITIVITY" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <c:ValueStepper Value="{Binding Sensitivity, Mode=TwoWay}" Minimum="0.01" Maximum="100" Step="0.05" Decimals="2"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding CalcText}" Margin="0,14,0,0" FontWeight="Medium" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE962;" Title="Mouse test pad" Subtitle="Check how the pointer follows your mouse, and your polling rate"/>
                    <c:MouseTestPad x:Name="Pad" MouseDpi="{Binding Dpi}"/>
                    <TextBlock Text="{Binding MultiplierText, ElementName=Pad}" FontWeight="Medium" Margin="2,12,0,0"/>
                    <TextBlock Text="{Binding AccelText, ElementName=Pad}" Style="{StaticResource Muted}" Margin="2,4,0,0"/>
                    <TextBlock Text="{Binding DpiText, ElementName=Pad}" Style="{StaticResource Muted}" Margin="2,4,0,0"/>
                    <TextBlock Text="{Binding PollingText, ElementName=Pad}" Style="{StaticResource Muted}" Margin="2,4,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="2,10,0,0" Text="Games with raw input (most shooters) ignore Windows pointer settings and read the mouse directly. For custom acceleration curves you need a separate driver like Raw Accel."/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE946;" Title="Current Windows state" Subtitle="{Binding CurrentText}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= DNS ================= -->
        <StackPanel Visibility="{Binding DataContext.Tab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Eq}, ConverterParameter=3}" DataContext="{Binding Dns}">
            <c:InfoBanner Kind="Info" Text="Tests send real DNS queries from this PC to each resolver and measure the response time. A faster resolver can speed up looking up server names; it does not change in-game ping. Applying DNS needs administrator approval (Windows will ask)."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <c:CardHeader Icon="&#xE774;" Title="Network adapter" Subtitle="{Binding CurrentDns, StringFormat=Current DNS: {0}}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshAdaptersCommand}"/>
                    </Grid>
                    <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding Adapter}" DisplayMemberPath="Name" Margin="0,14,0,0" AutomationProperties.Name="Network adapter"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Grid Margin="18,14,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/><ColumnDefinition Width="120"/><ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PROVIDER" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Column="1" Text="SERVERS" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Column="2" Text="LATENCY" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Column="3" Text="REPLIES" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource Label}"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding CustomText, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. 192.168.1.1 (optionally a second address after a comma)" AutomationProperties.Name="Custom DNS resolver"/>
                        <Button Grid.Column="1" Content="Add your own" Command="{Binding AddCustomCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/><ColumnDefinition Width="120"/><ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource Chip}" Background="{DynamicResource SuccessSoftBrush}" Margin="8,0,0,0" Visibility="{Binding IsBest, Converter={StaticResource BoolVisible}}">
                                                <TextBlock Text="FASTEST" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Visibility="{Binding IsCurrent, Converter={StaticResource BoolVisible}}">
                                                <TextBlock Text="IN USE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Servers}" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LatencyText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding SuccessText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <c:StatusDot Kind="{Binding Kind}"/>
                                            <TextBlock Text="{Binding Status}" Margin="8,0,0,0" FontSize="12.5" Foreground="{Binding Kind, Converter={StaticResource StatusBrush}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove custom resolver" AutomationProperties.Name="Remove custom resolver" Margin="0,0,6,0"
                                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolVisible}}"
                                                    Command="{Binding DataContext.RemoveCustomCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="Apply" Padding="12,5"
                                                    Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Test all" Command="{Binding TestCommand}" Style="{StaticResource PrimaryButton}" MinWidth="96"/>
                        <Button Content="Apply fastest" Command="{Binding ApplyBestCommand}" Margin="10,0,0,0"/>
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <c:InfoBanner Kind="{Binding Kind}" Text="{Binding Message}" Margin="0,14,0,0" Visibility="{Binding Message, Converter={StaticResource NullVisible}}"/>
                    <Border Style="{StaticResource Divider}" Margin="0,16,0,2"/>
                    <c:SettingRow Title="Apply the fastest automatically" Description="After “Test all”, switch to the fastest reliable resolver without asking again. Windows still asks for administrator approval.">
                        <CheckBox IsChecked="{Binding Settings.AutoApplyBest}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}" Margin="0,2,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Restore previous DNS" FontWeight="Medium"/>
                            <TextBlock Text="{Binding BackupText}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Restore" Command="{Binding RestoreCommand}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= QoS ================= -->
        <StackPanel Visibility="{Binding DataContext.Tab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Eq}, ConverterParameter=4}" DataContext="{Binding Qos}">
            <c:InfoBanner Kind="Warning" Text="What this does: Windows marks outgoing Roblox packets with a DSCP value. What it doesn't do: guarantee lower ping. Home routers and ISPs usually ignore or clear DSCP tags, and on PCs that aren't joined to a domain Windows may not apply the marking at all. Treat it as optional and verify with your own testing."/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE946;" Title="Roblox traffic policy" Subtitle="{Binding AppName, StringFormat=Applies to {0} on all network profiles.}"/>
                    <TextBlock Text="DSCP VALUE" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" AutomationProperties.Name="DSCP value"/>
                    <c:SettingRow Title="Use on home Wi-Fi and Ethernet" Description="Without this, Windows only uses the policy on work (domain) networks. Needs administrator approval once." Margin="0,16,0,0">
                        <CheckBox IsChecked="{Binding UseOnHome}"/>
                    </c:SettingRow>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Apply policy" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
                        <Button Content="Remove policy" Command="{Binding RemoveCommand}" Margin="10,0,0,0"/>
                        <Button Content="Refresh status" Command="{Binding RefreshCommand}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <c:InfoBanner Kind="{Binding Kind}" Text="{Binding Message}" Margin="0,14,0,0" Visibility="{Binding Message, Converter={StaticResource NullVisible}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Status" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <c:StatusDot Kind="{Binding StatusKind}"/>
                        <TextBlock Text="{Binding Status}" Margin="9,0,0,0"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="Creating or removing a policy requires administrator approval; Windows will show a prompt."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
