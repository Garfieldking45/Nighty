<Window x:Class="Nighty.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nighty" Icon="/Assets/Nighty.ico" Width="540" Height="360" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen" FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Topmost="True">
    <Window.Resources>
        <Storyboard x:Key="Intro">
            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" From="0.94" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" From="0.94" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.7" Duration="0:0:1.6" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.7" Duration="0:0:1.6" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:1.6" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="LogoFloat" Storyboard.TargetProperty="Y" From="0" To="-5" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShimmerShift" Storyboard.TargetProperty="X" From="-120" To="300" Duration="0:0:1.3" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded"><BeginStoryboard Storyboard="{StaticResource Intro}"/></EventTrigger>
    </Window.Triggers>

    <Grid Margin="30">
        <Border x:Name="Card" CornerRadius="22" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Border.RenderTransform><ScaleTransform x:Name="CardScale"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="Black"/></Border.Effect>
            <Grid ClipToBounds="True">
                <Grid.Clip><RectangleGeometry Rect="0,0,480,300" RadiusX="22" RadiusY="22"/></Grid.Clip>
                <!-- soft accent glow behind the logo -->
                <Ellipse Width="360" Height="360" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-210,0,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Opacity>0.28</Ellipse.Opacity>
                </Ellipse>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Grid Width="92" Height="92" HorizontalAlignment="Center">
                        <Ellipse x:Name="Pulse" Fill="{DynamicResource AccentBrush}" Opacity="0.4" RenderTransformOrigin="0.5,0.5" Margin="14">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Border Width="68" Height="68" CornerRadius="20" Background="{DynamicResource PremiumBrush}">
                            <Border.RenderTransform><TranslateTransform x:Name="LogoFloat"/></Border.RenderTransform>
                            <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="28" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                            <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="Nighty" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="StepText" Text="Starting" FontSize="13.5" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"/>

                    <Grid Width="280" Height="6" Margin="0,22,0,0">
                        <Border CornerRadius="3" Background="{DynamicResource Panel3Brush}"/>
                        <Border x:Name="Fill" CornerRadius="3" Background="{DynamicResource PremiumBrush}" HorizontalAlignment="Left" Width="0" ClipToBounds="True">
                            <Border Width="90" HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Border.RenderTransform><TranslateTransform x:Name="ShimmerShift"/></Border.RenderTransform>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#55FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="VersionLabel" FontSize="11.5" Foreground="{DynamicResource DimBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
            </Grid>
        </Border>
    </Grid>
</Window>
