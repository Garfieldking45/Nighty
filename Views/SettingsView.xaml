<UserControl x:Class="Nighty.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nighty.Controls">
    <UserControl.Resources>
        <!-- Round colour swatch with a check mark when selected -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="40" Height="40" Margin="6,0,0,0" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" Visibility="Collapsed"/>
                            <Ellipse Margin="5" Fill="{TemplateBinding Background}"/>
                            <TextBlock x:Name="Check" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="#06101F" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <c:PageHeading Title="Settings" Subtitle="How Nighty looks, starts and stays safe."/>

        <WrapPanel Margin="0,0,0,10">
            <RadioButton Style="{StaticResource TabButton}" Content="Appearance" GroupName="stab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=0}"/>
            <RadioButton Style="{StaticResource TabButton}" Content="Startup" GroupName="stab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=1}"/>
            <RadioButton Style="{StaticResource TabButton}" Content="Safety" GroupName="stab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=2}"/>
            <RadioButton Style="{StaticResource TabButton}" Content="Configuration" GroupName="stab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=3}"/>
            <RadioButton Style="{StaticResource TabButton}" Content="Changelog" GroupName="stab" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=4}"/>
        </WrapPanel>

        <!-- ===== Appearance ===== -->
        <StackPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=0}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE790;" Title="Appearance" Subtitle="Colors and window"/>
                    <c:SettingRow Title="Accent color" Description="The color of buttons and highlights across the app.">
                        <ItemsControl ItemsSource="{Binding Swatches}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource Swatch}" GroupName="swatch" ToolTip="{Binding Choice.Name}" AutomationProperties.Name="{Binding Choice.Name}"
                                                 Background="{Binding Choice.Accent}" BorderBrush="{Binding Choice.Accent}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 CommandParameter="{Binding Choice.Id}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Keep window on top" Description="Keeps the Nighty window above other windows.">
                        <CheckBox IsChecked="{Binding General.AlwaysOnTop}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Notifications" Description="Show a brief message in the bottom-right corner (over the game) when you toggle something.">
                        <CheckBox IsChecked="{Binding General.ShowNotifications}"/>
                    </c:SettingRow>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== Startup ===== -->
        <StackPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=1}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE7E8;" Title="How Nighty opens" Subtitle="Startup and closing"/>
                    <c:SettingRow Title="Start with Windows" Description="Launch Nighty when you sign in.">
                        <CheckBox IsChecked="{Binding StartWithWindows}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Start minimized" Description="Open in the taskbar instead of on screen when Nighty starts with Windows (or with --minimized).">
                        <CheckBox IsChecked="{Binding StartMinimized}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Restore Windows settings on close" Description="When Nighty closes, put the pointer, keyboard and accessibility settings, PC tweaks and Game Mode back to normal. Tweaks come back on at the next start.">
                        <CheckBox IsChecked="{Binding General.RestoreOnClose}"/>
                    </c:SettingRow>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== Safety ===== -->
        <StackPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=2}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE72E;" Title="Safety" Subtitle="Stop everything, and put Windows back"/>
                    <c:SettingRow Title="Emergency stop hotkey" Description="Instantly stops the clicker and all running macros, from anywhere.">
                        <c:HotkeyBox Vk="{Binding General.StopHotkeyVk, Mode=TwoWay}" Mods="{Binding General.StopHotkeyMods, Mode=TwoWay}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Restore system changes" Description="Turns Game Mode off and restores keyboard and pointer settings. DNS, QoS and mods are restored from their own pages.">
                        <Button Content="Restore now" Command="{Binding RestoreAllCommand}"/>
                    </c:SettingRow>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding Message, Converter={StaticResource NullVisible}}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE7EF;" Title="Permissions" Subtitle="Nighty runs without administrator rights"/>
                    <c:SettingRow Title="{Binding AdminText}" Description="It asks for approval only for DNS, QoS and the FPS overlay.">
                        <Button Content="Restart as administrator" Command="{Binding RelaunchAdmin}"/>
                    </c:SettingRow>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== Configuration ===== -->
        <StackPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=3}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE8B7;" Title="Configuration" Subtitle="Your settings, backups and logs"/>
                    <c:SettingRow Title="App data folder" Description="{Binding SettingsPath}">
                        <Button Content="Open" Command="{Binding OpenDataFolder}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Logs" Description="Diagnostic logs for troubleshooting.">
                        <Button Content="Open logs folder" Command="{Binding OpenLogsFolder}"/>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Profile" Description="Save your whole setup as plain JSON to back it up or share it, or load someone else's. Importing restarts Nighty.">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export" Command="{Binding ExportProfileCommand}"/>
                            <Button Content="Import" Command="{Binding ImportProfileCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </c:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <c:SettingRow Title="Reset everything" Description="Restores system changes, deletes presets, macros and layout, and restarts.">
                        <Button Content="Reset all settings" Style="{StaticResource DangerButton}" Command="{Binding ResetCommand}"/>
                    </c:SettingRow>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== Changelog ===== -->
        <StackPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=4}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:CardHeader Icon="&#xE81C;" Title="Changelog" Subtitle="What changed in each version"/>
                    <ItemsControl ItemsSource="{Binding Changelog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Body}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Style="{StaticResource Muted}" Margin="2,2,0,0">
            <Run Text="Nighty"/><Run Text=" "/><Run Text="{Binding Version, Mode=OneWay}"/>
        </TextBlock>
    </StackPanel>
</UserControl>
